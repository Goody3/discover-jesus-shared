{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Discover Jesus Actions Schema",
  "type": "object",

  "definitions": {
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "navigate",
            "apiCall",
            "showModal",
            "openExternalUrl",
            "setLocal",
            "getLocal",
            "navigateIf",
            "sequence",
            "animate"
          ],
          "description": "Action type identifier."
        },

        "pageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Stable UUID of the destination page for navigate and navigateIf actions."
        },

        "modalId": {
          "type": "string",
          "description": "Identifier of the modal opened by a showModal action."
        },

        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "HTTPS destination URL for an openExternalUrl action."
        },

        "condition": {
          "type": "string",
          "description": "Condition expression evaluated by navigateIf. Expression syntax and evaluation semantics are not defined by this schema."
        },

        "params": {
          "type": "object",
          "description": "Parameters passed to navigation or API calls.",
          "additionalProperties": true
        },

        "endpoint": {
          "type": "string",
          "description": "Backend API endpoint for apiCall actions."
        },

        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE"],
          "description": "HTTP method for apiCall."
        },

        "body": {
          "type": "object",
          "description": "Payload for apiCall.",
          "additionalProperties": true
        },

        "onSuccess": {
          "$ref": "#/definitions/action",
          "description": "Action triggered on successful API response."
        },

        "onFailure": {
          "$ref": "#/definitions/action",
          "description": "Action triggered on failed API response."
        },

        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" },
          "description": "Sequence of actions for multi-step flows."
        },

        "animation": {
          "type": "string",
          "enum": ["fadeIn", "fadeOut", "slideUp", "slideDown"],
          "description": "Basic animation type."
        }
      },
      "not": {
        "required": ["target"]
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "navigate" } },
            "required": ["type"]
          },
          "then": {
            "required": ["pageId"],
            "not": {
              "anyOf": [
                { "required": ["modalId"] },
                { "required": ["url"] },
                { "required": ["condition"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "navigateIf" } },
            "required": ["type"]
          },
          "then": {
            "required": ["pageId", "condition"],
            "not": {
              "anyOf": [
                { "required": ["modalId"] },
                { "required": ["url"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "showModal" } },
            "required": ["type"]
          },
          "then": {
            "required": ["modalId"],
            "not": {
              "anyOf": [
                { "required": ["pageId"] },
                { "required": ["url"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "openExternalUrl" } },
            "required": ["type"]
          },
          "then": {
            "required": ["url"],
            "not": {
              "anyOf": [
                { "required": ["pageId"] },
                { "required": ["modalId"] }
              ]
            }
          }
        }
      ]
    }
  }
}
